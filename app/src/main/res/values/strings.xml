    <!-- Tema: acompanhante -->
    <string name="dir_acomp_titulo">Direito a Acompanhante</string>
    <string name="dir_acomp_desc">Acompanhante e doula no parto</string>
    <string name="dir_acomp_1_titulo">Lei do Acompanhante</string>
    <string name="dir_acomp_1_selo">Lei nº 11.108/2005</string>
    <string name="dir_acomp_1_texto">Toda mulher tem o direito a um acompanhante de sua livre escolha durante todo o período de trabalho de parto, parto e pós-parto imediato, tanto no SUS quanto em hospitais particulares. O hospital não pode proibir a presença nem limitar o horário.</string>
    <string name="dir_acomp_2_titulo">Presença de doula</string>
    <string name="dir_acomp_2_selo">Legislações locais</string>
    <string name="dir_acomp_2_texto">Em diversas cidades e estados, legislações específicas também garantem o direito à presença de doula (profissional de suporte físico e emocional), de forma acumulada com o acompanhante de livre escolha.</string>

    <!-- Tema: dignidade -->
    <string name="dir_dign_titulo">Dignidade, Respeito e Consentimento Informado</string>
    <string name="dir_dign_desc">Respeito e consentimento no parto</string>
    <string name="dir_dign_1_titulo">Plano de parto</string>
    <string name="dir_dign_1_selo">Preferências por escrito</string>
    <string name="dir_dign_1_texto">A gestante tem o direito de apresentar um documento escrito com suas preferências para o parto (como posições para parir, métodos não farmacológicos de alívio da dor, contato pele a pele imediato), e a equipe deve respeitá-las ou justificar tecnicamente qualquer alteração necessária.</string>
    <string name="dir_dign_2_titulo">Atendimento humanizado</string>
    <string name="dir_dign_2_selo">Sem violência obstétrica</string>
    <string name="dir_dign_2_texto">É direito ser tratada com respeito, dignidade, sem discriminação e livre de qualquer violência obstétrica, que envolve desde agressões verbais e físicas até procedimentos desnecessários ou realizados sem consentimento.</string>
    <string name="dir_dign_3_titulo">Consentimento informado</string>
    <string name="dir_dign_3_selo">Você pode recusar</string>
    <string name="dir_dign_3_texto">Nenhum procedimento médico (como episiotomia, uso de ocitocina ou exames invasivos de rotina) pode ser feito sem que a equipe explique claramente os riscos, benefícios e alternativas, cabendo à gestante aceitá-los ou recusá-los.</string>

    <!-- Tema: vínculo -->
    <string name="dir_vinc_titulo">Vínculo com a Maternidade e Atendimento</string>
    <string name="dir_vinc_desc">Maternidade, vaga e alívio da dor</string>
    <string name="dir_vinc_1_titulo">Acesso a alívio da dor</string>
    <string name="dir_vinc_1_selo">Anestesia e outros métodos</string>
    <string name="dir_vinc_1_texto">Todos os estabelecimentos de saúde devem disponibilizar meios e recursos (inclusive anestésicos e métodos não farmacológicos, como chuveiro, bola, massagem) para o alívio da dor durante o trabalho de parto.</string>
    <string name="dir_vinc_2_titulo">Vínculo prévio</string>
    <string name="dir_vinc_2_selo">Lei nº 11.634/2007</string>
    <string name="dir_vinc_2_texto">A gestante no SUS tem o direito de conhecer e ser vinculada antecipadamente à maternidade na qual vai dar à luz.</string>
    <string name="dir_vinc_3_titulo">Vaga garantida</string>
    <string name="dir_vinc_3_selo">Transferência segura</string>
    <string name="dir_vinc_3_texto">O sistema de saúde deve assegurar vaga de internação e transferência segura caso a unidade vinculada não tenha condições de atendimento no momento.</string>

    <!-- Tema: pós-parto -->
    <string name="dir_pos_titulo">Pós-Parto e Bebê</string>
    <string name="dir_pos_desc">Amamentação, registro e prontuário</string>
    <string name="dir_pos_1_titulo">Alojamento conjunto e amamentação</string>
    <string name="dir_pos_1_selo">Primeira hora de vida</string>
    <string name="dir_pos_1_texto">O bebê tem o direito de permanecer junto à mãe desde o nascimento (salvo necessidade médica) e a amamentação em livre demanda deve ser estimulada logo na primeira hora de vida.</string>
    <string name="dir_pos_2_titulo">Registro civil no hospital</string>
    <string name="dir_pos_2_selo">Desde 2015</string>
    <string name="dir_pos_2_texto">Desde 2015, os hospitais e maternidades possuem postos ou mecanismos para realizar o registro de nascimento do bebê antes da alta.</string>
    <string name="dir_pos_3_titulo">Acesso ao prontuário</string>
    <string name="dir_pos_3_selo">Cópia integral</string>
    <string name="dir_pos_3_texto">A mulher tem o direito de requerer e obter uma cópia integral do seu prontuário médico e do cartão de acompanhamento.</string>

